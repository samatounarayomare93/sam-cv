# ==========================================
# Project Chronos - Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# ==========================================
# 🌩️ SUPABASE DATABASE (Required)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# ==========================================
# 🤖 AI API KEYS
# ==========================================
GEMINI_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# ==========================================
# 📧 EMAIL CONFIGURATION
# ==========================================

# Gmail SMTP (Recommended for reliability)
GMAIL_SMTP_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Brevo SMTP (For high-volume sending)
BREVO_SMTP_LOGIN=your-brevo-login
BREVO_SMTP_PASSWORD=your-brevo-password

# Test mode - sends all emails to this address
TEST_RECEIVER_EMAIL=your-test-email@example.com

# ==========================================
# 📱 TELEGRAM CONTROL (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN="your_token_here"
TELEGRAM_API_ID="your_api_id"
TELEGRAM_API_HASH="your_api_hash"
AUTHORIZED_CHATS="your_chat_id_here"

# ==========================================
# 📊 BREVO EMAIL TRACKING (Optional)
# ==========================================
BREVO_API_KEY=your-brevo-api-key

# ==========================================
# 🛠️ GITHUB ACTIONS (Optional)
# ==========================================
GITHUB_PAT=your-github-personal-access-token

# ==========================================
# ⚙️ OPERATION MODE
# ==========================================
USE_AI_ANALYSIS=true
ZERO_INVESTMENT_MODE=true
PREFER_GMAIL_ONLY=true
ALLOW_BREVO_IN_ZERO_MODE=false

# ==========================================
# 🚀 THROUGHPUT CONTROLS
# ==========================================
MAX_PARALLEL_STRIKES=3
MAX_QUALIFIED_LEADS_PER_CYCLE=40
ENABLE_NATURAL_BREAKS=false
NATURAL_BREAK_PROBABILITY=0.15
NATURAL_BREAK_MINUTES_MIN=1
NATURAL_BREAK_MINUTES_MAX=3

# ==========================================
# 🔧 OPTIONAL
# ==========================================
SCRAPER_API_KEY=
